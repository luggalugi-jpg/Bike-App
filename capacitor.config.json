{
  "appId": "de.preikschas.downhill",
  "appName": "Gravity",
  "webDir": "www",
  "android": {
    "backgroundColor": "#0E0F11",
    "allowMixedContent": false,
    "useLegacyBridge": true
  },
  "plugins": {
    "LocalNotifications": {
      "iconColor": "#C6FF3D"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "CapacitorHttp": {
      "enabled": true
    }
  }
}